# Choose: anthropic | openai | ollama
# LLM_PROVIDER=anthropic

# --- Anthropic (recommended) ---
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- OpenAI (alternative) ---
